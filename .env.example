# GEMINI_API_KEY: Chave secreta da API Gemini (usada exclusivamente no backend Express).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL principal onde a aplicacao frontend/backend e servida.
APP_URL="https://nashixhoo.github.io"

# ALLOWED_ORIGINS: Lista separada por virgula de origens autorizadas no CORS do backend.
ALLOWED_ORIGINS="https://nashixhoo.github.io,http://localhost:3000,http://127.0.0.1:3000"

# FIREBASE_PROJECT_ID & FIRESTORE_DATABASE_ID: Configuracao do Firebase Admin SDK no backend.
FIREBASE_PROJECT_ID="gen-lang-client-0214739740"
FIRESTORE_DATABASE_ID="ai-studio-guitaracademyfor-e7ce9efa-82d3-4dd1-8b8e-58aa69749913"

# PORT: Porta HTTP do servidor Express (3000 em desenvolvimento/AI Studio, 8080 em Cloud Run).
PORT="3000"

# VITE_PROFESSOR_API_URL: URL base do backend independente quando publicado fora do GitHub Pages.
# Exemplo: https://guitar-academy-api-xxxxx.a.run.app
VITE_PROFESSOR_API_URL=""
