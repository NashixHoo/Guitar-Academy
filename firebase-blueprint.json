{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Dados do perfil do aluno autenticado via Google",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "UID único do usuário no Firebase Auth"
        },
        "displayName": {
          "type": "string",
          "description": "Nome de exibição do estudante"
        },
        "email": {
          "type": "string",
          "description": "Endereço de e-mail Google do estudante"
        },
        "photoURL": {
          "type": "string",
          "description": "URL da foto de perfil da conta Google"
        },
        "createdAt": {
          "type": "string",
          "description": "Data de primeiro acesso do aluno (ISO 8601)"
        },
        "lastLoginAt": {
          "type": "string",
          "description": "Data do acesso mais recente do aluno (ISO 8601)"
        }
      },
      "required": ["uid", "email"]
    },
    "UserProgress": {
      "title": "UserProgress",
      "description": "Progresso de estudos, aulas concluídas, rotinas e domínio pedagógico isolado por aluno",
      "type": "object",
      "properties": {
        "currentLessonId": {
          "type": "string",
          "description": "Identificador da aula atualmente em estudo"
        },
        "completedLessons": {
          "type": "array",
          "description": "Lista de IDs de aulas concluídas com sucesso"
        },
        "totalStudyTimeSeconds": {
          "type": "number",
          "description": "Segundos totais de estudo acumulados"
        },
        "todayStudyTimeSeconds": {
          "type": "number",
          "description": "Segundos de estudo acumulados no dia de hoje"
        },
        "lastStudyDate": {
          "type": "string",
          "description": "Data do último estudo no calendário local (YYYY-MM-DD)"
        },
        "practicedBpm": {
          "type": "number",
          "description": "Maior BPM praticado no metrônomo"
        },
        "lastUpdated": {
          "type": "string",
          "description": "Timestamp ISO da sincronização na nuvem"
        }
      },
      "required": ["currentLessonId", "completedLessons"]
    },
    "ClassGroup": {
      "title": "ClassGroup",
      "description": "Turma pedagógica sob responsabilidade de um professor",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID único da turma" },
        "name": { "type": "string", "description": "Nome da turma" },
        "code": { "type": "string", "description": "Código de convite seguro" },
        "description": { "type": "string", "description": "Descrição da turma" },
        "courseId": { "type": "string", "description": "Curso oficial associado" },
        "instrument": { "type": "string", "description": "Instrumento ou formação da turma" },
        "teacherId": { "type": "string", "description": "UID do professor responsável" },
        "teacherEmail": { "type": "string", "description": "E-mail do professor" },
        "teacherName": { "type": "string", "description": "Nome do professor" },
        "maxStudents": { "type": "number", "description": "Limite máximo de vagas" },
        "enrolledCount": { "type": "number", "description": "Contagem atômica de alunos ativos na turma" },
        "expiresAt": { "type": "string", "description": "Data de expiração opcional (ISO 8601)" },
        "expiresAtMs": { "type": "number", "description": "Timestamp de expiração em milissegundos (epoch ms)" },
        "active": { "type": "boolean", "description": "Indica se a turma está ativa" },
        "createdAt": { "type": "string", "description": "Data de criação" }
      },
      "required": ["id", "name", "code", "teacherId"]
    },
    "ClassEnrollment": {
      "title": "ClassEnrollment",
      "description": "Vínculo formal de um aluno matriculado em uma turma",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID do vínculo" },
        "classId": { "type": "string", "description": "ID da turma" },
        "studentId": { "type": "string", "description": "UID do aluno matriculado" },
        "studentName": { "type": "string", "description": "Nome do aluno" },
        "studentEmail": { "type": "string", "description": "E-mail do aluno" },
        "teacherId": { "type": "string", "description": "UID do professor" },
        "status": { "type": "string", "description": "Estado da matrícula" },
        "joinedAt": { "type": "string", "description": "Data de ingresso" }
      },
      "required": ["classId", "studentId", "teacherId", "status"]
    },
    "EducationalEvent": {
      "title": "EducationalEvent",
      "description": "Registro analítico de evento educacional da turma",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID do evento" },
        "studentUid": { "type": "string", "description": "UID do aluno" },
        "studentName": { "type": "string", "description": "Nome do aluno" },
        "classId": { "type": "string", "description": "ID da turma" },
        "courseId": { "type": "string", "description": "Curso relacionado" },
        "eventType": { "type": "string", "description": "Tipo de evento educacional" },
        "category": { "type": "string", "description": "Categoria pedagógica" },
        "durationSeconds": { "type": "number", "description": "Duração em segundos" },
        "timestamp": { "type": "string", "description": "Timestamp ISO" }
      },
      "required": ["studentUid", "classId", "eventType", "timestamp"]
    },
    "UserRoleRecord": {
      "title": "UserRoleRecord",
      "description": "Registro administrativo de papel e privilégios de acesso",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "UID do usuário" },
        "role": { "type": "string", "description": "Papel atribuído (student, teacher, admin)" },
        "assignedAt": { "type": "string", "description": "Data de atribuição" },
        "assignedBy": { "type": "string", "description": "Administrador responsável" }
      },
      "required": ["uid", "role"]
    },
    "Course": {
      "title": "Course",
      "description": "Curso acadêmico da Guitar Academy",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID do curso" },
        "title": { "type": "string", "description": "Título do curso" }
      },
      "required": ["id", "title"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "Aula estruturada de um curso",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID da aula" },
        "title": { "type": "string", "description": "Título da aula" }
      },
      "required": ["id", "title"]
    },
    "PracticeRecord": {
      "title": "PracticeRecord",
      "description": "Registro de sessão prática individual de estudo",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID do estudante" },
        "durationMinutes": { "type": "number", "description": "Duração em minutos" }
      },
      "required": ["userId", "durationMinutes"]
    },
    "TeacherStudentLink": {
      "title": "TeacherStudentLink",
      "description": "Vínculo direto entre professor e aluno",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "description": "UID do aluno" },
        "teacherId": { "type": "string", "description": "UID do professor" }
      },
      "required": ["studentId", "teacherId"]
    },
    "ClassInvite": {
      "title": "ClassInvite",
      "description": "Convite indexado por código para ingresso seguro de aluno em turma",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "description": "ID da turma" },
        "code": { "type": "string", "description": "Código de convite" },
        "name": { "type": "string", "description": "Nome da turma" },
        "description": { "type": "string", "description": "Descrição da turma" },
        "courseId": { "type": "string", "description": "Curso oficial associado" },
        "instrument": { "type": "string", "description": "Instrumento ou formação da turma" },
        "teacherId": { "type": "string", "description": "UID do professor responsável" },
        "teacherName": { "type": "string", "description": "Nome do professor" },
        "maxStudents": { "type": "number", "description": "Limite máximo de vagas" },
        "expiresAt": { "type": "string", "description": "Data de expiração opcional (ISO 8601)" },
        "expiresAtMs": { "type": "number", "description": "Timestamp de expiração em milissegundos (epoch ms)" },
        "active": { "type": "boolean", "description": "Convite ativo" }
      },
      "required": ["classId", "code", "teacherId", "active"]
    },
    "AdminLogEntry": {
      "title": "AdminLogEntry",
      "description": "Registro imutável de auditoria para eventos de autenticação e ações sensíveis de segurança",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-\\.:]+$",
          "description": "Identificador único do evento de auditoria"
        },
        "eventType": {
          "type": "string",
          "enum": [
            "auth",
            "database_access",
            "role_change",
            "auth_login_success",
            "auth_login_failed",
            "auth_signup",
            "auth_logout",
            "auth_password_reset",
            "role_checked",
            "role_escalation_blocked",
            "admin_preview_toggled",
            "student_status_updated",
            "security_audit_viewed",
            "auth_token_rejected",
            "role_access_denied",
            "admin_role_lookup",
            "course_access_granted",
            "course_access_updated",
            "course_access_revoked",
            "course_access_reactivated",
            "student_placement_updated",
            "commerce_product_created",
            "commerce_product_updated",
            "commerce_price_version_created",
            "commerce_promotion_created",
            "commerce_promotion_updated",
            "commerce_coupon_updated",
            "commerce_config_updated",
            "commerce_unauthorized_attempt",
            "commerce_advertisement_created",
            "commerce_advertisement_updated",
            "commerce_advertisement_image_uploaded",
            "commerce_class_offer_created",
            "commerce_class_offer_updated",
            "commerce_reservation_updated",
            "commerce_waitlist_summoned",
            "commerce_order_created",
            "commerce_payment_confirmed",
            "commerce_payment_invalid",
            "commerce_payment_refunded",
            "commerce_subscription_updated",
            "commerce_financial_adjustment"
          ],
          "description": "Categoria do evento de segurança ou autenticação"
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "critical"],
          "description": "Nível de criticidade do evento"
        },
        "actorUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-\\.:]+$",
          "description": "UID do usuário que originou a ação"
        },
        "actorEmail": {
          "type": "string",
          "maxLength": 254,
          "description": "E-mail do ator autenticado quando disponível"
        },
        "actorRole": {
          "type": "string",
          "enum": ["student", "teacher", "admin", "unauthenticated"],
          "description": "Papel efetivo do ator no momento do evento"
        },
        "targetUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-\\.:]+$",
          "description": "UID de destino afetado pela operação administrativa, se aplicável"
        },
        "action": {
          "type": "string",
          "maxLength": 160,
          "description": "Descrição resumida da ação executada"
        },
        "details": {
          "type": "string",
          "maxLength": 500,
          "description": "Contexto técnico complementar sanitizado"
        },
        "source": {
          "type": "string",
          "enum": ["client", "backend", "admin_portal"],
          "description": "Origem do registro de auditoria"
        },
        "timestamp": {
          "type": "string",
          "maxLength": 40,
          "description": "Timestamp ISO 8601 do evento"
        }
      },
      "required": ["id", "eventType", "severity", "actorUid", "actorRole", "action", "source", "timestamp"]
    },
    "CourseAccessGrant": {
      "title": "CourseAccessGrant",
      "description": "Concessão administrativa individual de acesso gratuito (curso, instrumento, módulo, aula ou intervalo)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentUid": { "type": "string", "maxLength": 128 },
        "scopeType": { "type": "string", "enum": ["course", "instrument", "module", "lesson", "lesson_range"] },
        "grantType": { "type": "string", "enum": ["permanent", "temporary", "trial", "special"] },
        "source": { "type": "string", "enum": ["admin_permanent", "admin_temporary", "admin_trial", "admin_special"] },
        "status": { "type": "string", "enum": ["active", "suspended", "revoked", "expired"] },
        "courseId": { "type": "string", "maxLength": 64 },
        "instrumentId": { "type": "string", "maxLength": 64 },
        "moduleId": { "type": "string", "maxLength": 128 },
        "lessonId": { "type": "string", "maxLength": 128 },
        "rangeStartLessonId": { "type": "string", "maxLength": 128 },
        "rangeEndLessonId": { "type": "string", "maxLength": 128 },
        "lessonIds": { "type": "array", "items": { "type": "string" } },
        "startsAt": { "type": "string", "maxLength": 40 },
        "startsAtMs": { "type": "integer" },
        "expiresAt": { "type": "string", "maxLength": 40 },
        "expiresAtMs": { "type": "integer" },
        "reason": { "type": "string", "maxLength": 500 },
        "idempotencyKey": { "type": "string", "maxLength": 300 },
        "grantedBy": { "type": "string", "maxLength": 128 },
        "grantedByEmail": { "type": "string", "maxLength": 254 },
        "revokedBy": { "type": "string", "maxLength": 128 },
        "revokedAt": { "type": "string", "maxLength": 40 },
        "statusReason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "studentUid", "scopeType", "grantType", "source", "status", "idempotencyKey", "grantedBy", "createdAt", "updatedAt"]
    },
    "StudentAcademicPlacement": {
      "title": "StudentAcademicPlacement",
      "description": "Direcionamento administrativo do ponto inicial do aluno no currículo sem perda de progresso anterior",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentUid": { "type": "string", "maxLength": 128 },
        "courseId": { "type": "string", "maxLength": 64 },
        "moduleId": { "type": "string", "maxLength": 128 },
        "moduleNumber": { "type": "integer" },
        "lessonId": { "type": "string", "maxLength": 128 },
        "mode": { "type": "string", "enum": ["custom_start", "default_path"] },
        "status": { "type": "string", "enum": ["active", "cleared"] },
        "reason": { "type": "string", "maxLength": 500 },
        "assignedBy": { "type": "string", "maxLength": 128 },
        "assignedByEmail": { "type": "string", "maxLength": 254 },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "studentUid", "courseId", "lessonId", "mode", "status", "assignedBy", "createdAt", "updatedAt"]
    },
    "CommerceProduct": {
      "title": "CommerceProduct",
      "description": "Produto comercial do catálogo estruturado da Guitar Academy (inicia oculto por padrão)",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 800 },
        "productType": {
          "type": "string",
          "enum": ["individual_course", "instrument_bundle", "subscription_plan", "lifetime_access", "experimental_course", "paid_class_offer"]
        },
        "courseIds": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["draft", "active", "archived"] },
        "visibility": { "type": "string", "enum": ["hidden", "public"] },
        "linkedClassId": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdByEmail": { "type": "string", "maxLength": 254 }
      },
      "required": ["productId", "name", "description", "productType", "courseIds", "status", "visibility", "createdAt", "updatedAt", "createdBy"]
    },
    "CommerceProductPrice": {
      "title": "CommerceProductPrice",
      "description": "Versão imutável de preço ou plano vinculado a um produto comercial",
      "type": "object",
      "properties": {
        "priceId": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "currency": { "type": "string", "enum": ["BRL", "USD", "EUR"] },
        "amount": { "type": "number" },
        "amountCents": { "type": "integer" },
        "billingInterval": { "type": "string", "enum": ["one_time", "monthly", "semiannual", "annual", "lifetime"] },
        "isPromotional": { "type": "boolean" },
        "promotionalLabel": { "type": "string", "maxLength": 80 },
        "version": { "type": "integer" },
        "previousPriceId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "superseded", "archived"] },
        "validFrom": { "type": "string", "maxLength": 40 },
        "validFromMs": { "type": "integer" },
        "validUntil": { "type": "string", "maxLength": 40 },
        "validUntilMs": { "type": "integer" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 40 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdByEmail": { "type": "string", "maxLength": 254 },
        "supersededAt": { "type": "string", "maxLength": 40 },
        "supersededBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["priceId", "productId", "currency", "amount", "amountCents", "billingInterval", "isPromotional", "version", "status", "createdAt", "createdBy"]
    },
    "CommercePromotion": {
      "title": "CommercePromotion",
      "description": "Promoção ou cupom comercial validado no servidor com controle de validade e limite",
      "type": "object",
      "properties": {
        "promotionId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "code": { "type": "string", "maxLength": 40 },
        "discountType": { "type": "string", "enum": ["percentage", "fixed_amount"] },
        "discountValue": { "type": "number" },
        "scopeType": { "type": "string", "enum": ["all_products", "product", "course", "bundle"] },
        "targetProductIds": { "type": "array", "items": { "type": "string" } },
        "targetCourseIds": { "type": "array", "items": { "type": "string" } },
        "startsAt": { "type": "string", "maxLength": 40 },
        "startsAtMs": { "type": "integer" },
        "endsAt": { "type": "string", "maxLength": 40 },
        "endsAtMs": { "type": "integer" },
        "maxRedemptions": { "type": "integer" },
        "maxPerStudent": { "type": "integer" },
        "redeemedCount": { "type": "integer" },
        "eligibleAudience": { "type": "string", "enum": ["all", "new_students", "enrolled_students", "specific_uids"] },
        "eligibleStudentUids": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["draft", "active", "paused", "ended"] },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdByEmail": { "type": "string", "maxLength": 254 }
      },
      "required": ["promotionId", "name", "discountType", "discountValue", "scopeType", "targetProductIds", "targetCourseIds", "redeemedCount", "eligibleAudience", "eligibleStudentUids", "status", "createdAt", "updatedAt", "createdBy"]
    },
    "CommerceGlobalConfig": {
      "title": "CommerceGlobalConfig",
      "description": "Interruptor global fail-closed do modo pago (permanece false por padrão até ativação administrativa explícita)",
      "type": "object",
      "properties": {
        "configId": { "type": "string", "enum": ["commerce"] },
        "commerceEnabled": { "type": "boolean" },
        "catalogVisible": { "type": "boolean" },
        "checkoutEnabled": { "type": "boolean" },
        "promotionsEnabled": { "type": "boolean" },
        "advertisementsEnabled": { "type": "boolean" },
        "paidClassesEnabled": { "type": "boolean" },
        "subscriptionsEnabled": { "type": "boolean" },
        "defaultCurrency": { "type": "string", "enum": ["BRL", "USD", "EUR"] },
        "updatedAt": { "type": "string", "maxLength": 40 },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedByEmail": { "type": "string", "maxLength": 254 },
        "lastActivationReason": { "type": "string", "maxLength": 500 },
        "failClosedVerified": { "type": "boolean" }
      },
      "required": ["configId", "commerceEnabled", "catalogVisible", "checkoutEnabled", "promotionsEnabled", "advertisementsEnabled", "paidClassesEnabled", "subscriptionsEnabled", "defaultCurrency", "failClosedVerified"]
    },
    "CommerceAdvertisement": {
      "title": "CommerceAdvertisement",
      "description": "Anúncio ou campanha promocional gerenciada exclusivamente por administradores com banner no Firebase Storage",
      "type": "object",
      "properties": {
        "advertisementId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 120 },
        "subtitle": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 800 },
        "ctaText": { "type": "string", "maxLength": 60 },
        "ctaDestination": { "type": "string", "maxLength": 240 },
        "productId": { "type": "string", "maxLength": 128 },
        "targetAudience": { "type": "string", "enum": ["all", "new_students", "enrolled_students", "specific_uids"] },
        "eligibleStudentUids": { "type": "array", "items": { "type": "string" } },
        "position": { "type": "string", "enum": ["home", "courses", "instruments", "promotions", "enrollments"] },
        "imageUrl": { "type": "string", "maxLength": 1024 },
        "storagePath": { "type": "string", "maxLength": 300 },
        "imageMimeType": { "type": "string", "enum": ["image/webp", "image/png", "image/jpeg"] },
        "imageSizeBytes": { "type": "integer" },
        "imageVersion": { "type": "integer" },
        "previousStoragePaths": { "type": "array", "items": { "type": "string" } },
        "startsAt": { "type": "string", "maxLength": 40 },
        "startsAtMs": { "type": "integer" },
        "endsAt": { "type": "string", "maxLength": 40 },
        "endsAtMs": { "type": "integer" },
        "status": { "type": "string", "enum": ["draft", "active", "paused", "archived"] },
        "isHomologation": { "type": "boolean" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdByEmail": { "type": "string", "maxLength": 254 },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["advertisementId", "title", "description", "ctaText", "ctaDestination", "targetAudience", "eligibleStudentUids", "position", "imageVersion", "previousStoragePaths", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "CommerceClassOffer": {
      "title": "CommerceClassOffer",
      "description": "Oferta comercial vinculada a uma turma existente sem duplicar ou recriar turmas acadêmicas",
      "type": "object",
      "properties": {
