{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Dados do perfil do aluno autenticado via Google",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "UID único do usuário no Firebase Auth"
        },
        "displayName": {
          "type": "string",
          "description": "Nome de exibição do estudante"
        },
        "email": {
          "type": "string",
          "description": "Endereço de e-mail Google do estudante"
        },
        "photoURL": {
          "type": "string",
          "description": "URL da foto de perfil da conta Google"
        },
        "createdAt": {
          "type": "string",
          "description": "Data de primeiro acesso do aluno (ISO 8601)"
        },
        "lastLoginAt": {
          "type": "string",
          "description": "Data do acesso mais recente do aluno (ISO 8601)"
        }
      },
      "required": ["uid", "email"]
    },
    "UserProgress": {
      "title": "UserProgress",
      "description": "Progresso de estudos, aulas concluídas, rotinas e domínio pedagógico isolado por aluno",
      "type": "object",
      "properties": {
        "currentLessonId": {
          "type": "string",
          "description": "Identificador da aula atualmente em estudo"
        },
        "completedLessons": {
          "type": "array",
          "description": "Lista de IDs de aulas concluídas com sucesso"
        },
        "totalStudyTimeSeconds": {
          "type": "number",
          "description": "Segundos totais de estudo acumulados"
        },
        "todayStudyTimeSeconds": {
          "type": "number",
          "description": "Segundos de estudo acumulados no dia de hoje"
        },
        "lastStudyDate": {
          "type": "string",
          "description": "Data do último estudo no calendário local (YYYY-MM-DD)"
        },
        "practicedBpm": {
          "type": "number",
          "description": "Maior BPM praticado no metrônomo"
        },
        "lastUpdated": {
          "type": "string",
          "description": "Timestamp ISO da sincronização na nuvem"
        }
      },
      "required": ["currentLessonId", "completedLessons"]
    },
    "ClassGroup": {
      "title": "ClassGroup",
      "description": "Turma pedagógica sob responsabilidade de um professor",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID único da turma" },
        "name": { "type": "string", "description": "Nome da turma" },
        "code": { "type": "string", "description": "Código de convite seguro" },
        "teacherId": { "type": "string", "description": "UID do professor responsável" },
        "teacherEmail": { "type": "string", "description": "E-mail do professor" },
        "teacherName": { "type": "string", "description": "Nome do professor" },
        "active": { "type": "boolean", "description": "Indica se a turma está ativa" },
        "createdAt": { "type": "string", "description": "Data de criação" }
      },
      "required": ["id", "name", "code", "teacherId"]
    },
    "ClassEnrollment": {
      "title": "ClassEnrollment",
      "description": "Vínculo formal de um aluno matriculado em uma turma",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID do vínculo" },
        "classId": { "type": "string", "description": "ID da turma" },
        "studentId": { "type": "string", "description": "UID do aluno matriculado" },
        "studentName": { "type": "string", "description": "Nome do aluno" },
        "studentEmail": { "type": "string", "description": "E-mail do aluno" },
        "teacherId": { "type": "string", "description": "UID do professor" },
        "status": { "type": "string", "description": "Estado da matrícula" },
        "joinedAt": { "type": "string", "description": "Data de ingresso" }
      },
      "required": ["classId", "studentId", "teacherId", "status"]
    },
    "EducationalEvent": {
      "title": "EducationalEvent",
      "description": "Registro analítico de evento educacional da turma",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID do evento" },
        "studentUid": { "type": "string", "description": "UID do aluno" },
        "studentName": { "type": "string", "description": "Nome do aluno" },
        "classId": { "type": "string", "description": "ID da turma" },
        "courseId": { "type": "string", "description": "Curso relacionado" },
        "eventType": { "type": "string", "description": "Tipo de evento educacional" },
        "category": { "type": "string", "description": "Categoria pedagógica" },
        "durationSeconds": { "type": "number", "description": "Duração em segundos" },
        "timestamp": { "type": "string", "description": "Timestamp ISO" }
      },
      "required": ["studentUid", "classId", "eventType", "timestamp"]
    },
    "UserRoleRecord": {
      "title": "UserRoleRecord",
      "description": "Registro administrativo de papel e privilégios de acesso",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "UID do usuário" },
        "role": { "type": "string", "description": "Papel atribuído (student, teacher, admin)" },
        "assignedAt": { "type": "string", "description": "Data de atribuição" },
        "assignedBy": { "type": "string", "description": "Administrador responsável" }
      },
      "required": ["uid", "role"]
    },
    "Course": {
      "title": "Course",
      "description": "Curso acadêmico da Guitar Academy",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID do curso" },
        "title": { "type": "string", "description": "Título do curso" }
      },
      "required": ["id", "title"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "Aula estruturada de um curso",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID da aula" },
        "title": { "type": "string", "description": "Título da aula" }
      },
      "required": ["id", "title"]
    },
    "PracticeRecord": {
      "title": "PracticeRecord",
      "description": "Registro de sessão prática individual de estudo",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID do estudante" },
        "durationMinutes": { "type": "number", "description": "Duração em minutos" }
      },
      "required": ["userId", "durationMinutes"]
    },
    "TeacherStudentLink": {
      "title": "TeacherStudentLink",
      "description": "Vínculo direto entre professor e aluno",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "description": "UID do aluno" },
        "teacherId": { "type": "string", "description": "UID do professor" }
      },
      "required": ["studentId", "teacherId"]
    },
    "ClassInvite": {
      "title": "ClassInvite",
      "description": "Convite indexado por código para ingresso seguro de aluno em turma",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "description": "ID da turma" },
        "code": { "type": "string", "description": "Código de convite" },
        "teacherId": { "type": "string", "description": "UID do professor responsável" },
        "active": { "type": "boolean", "description": "Convite ativo" }
      },
      "required": ["classId", "code", "teacherId", "active"]
    },
    "AdminLogEntry": {
      "title": "AdminLogEntry",
      "description": "Registro imutável de auditoria para eventos de autenticação e ações sensíveis de segurança",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-\\.:]+$",
          "description": "Identificador único do evento de auditoria"
        },
        "eventType": {
          "type": "string",
          "enum": [
            "auth_login_success",
            "auth_login_failed",
            "auth_signup",
            "auth_logout",
            "auth_password_reset",
            "role_checked",
            "role_escalation_blocked",
            "admin_preview_toggled",
            "student_status_updated",
            "security_audit_viewed",
            "auth_token_rejected",
            "role_access_denied",
            "admin_role_lookup"
          ],
          "description": "Categoria do evento de segurança ou autenticação"
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "critical"],
          "description": "Nível de criticidade do evento"
        },
        "actorUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-\\.:]+$",
          "description": "UID do usuário que originou a ação"
        },
        "actorEmail": {
          "type": "string",
          "maxLength": 254,
          "description": "E-mail do ator autenticado quando disponível"
        },
        "actorRole": {
          "type": "string",
          "enum": ["student", "teacher", "admin", "unauthenticated"],
          "description": "Papel efetivo do ator no momento do evento"
        },
        "targetUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-\\.:]+$",
          "description": "UID de destino afetado pela operação administrativa, se aplicável"
        },
        "action": {
          "type": "string",
          "maxLength": 160,
          "description": "Descrição resumida da ação executada"
        },
        "details": {
          "type": "string",
          "maxLength": 500,
          "description": "Contexto técnico complementar sanitizado"
        },
        "source": {
          "type": "string",
          "enum": ["client", "backend", "admin_portal"],
          "description": "Origem do registro de auditoria"
        },
        "timestamp": {
          "type": "string",
          "maxLength": 40,
          "description": "Timestamp ISO 8601 do evento"
        }
      },
      "required": ["id", "eventType", "severity", "actorUid", "actorRole", "action", "source", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Documento de perfil pessoal do aluno"
    },
    "/users/{userId}/data/progress": {
      "schema": "UserProgress",
      "description": "Dados completos de progresso e estudos do aluno"
    },
    "/classes/{classId}": {
      "schema": "ClassGroup",
      "description": "Turma sob gestão pedagógica de um professor"
    },
    "/classes/{classId}/students/{studentId}": {
      "schema": "ClassEnrollment",
      "description": "Vínculo de matrícula do aluno na turma"
    },
    "/classes/{classId}/events/{eventId}": {
      "schema": "EducationalEvent",
      "description": "Eventos de estudo e prática registrados para a turma"
    },
    "/class_invites/{inviteCode}": {
      "schema": "ClassInvite",
      "description": "Índice pontual de códigos de convite de turmas"
    },
    "/enrollments/{enrollmentId}": {
      "schema": "ClassEnrollment",
      "description": "Matrículas acadêmicas em nível raiz"
    },
    "/teacher_student_links/{linkId}": {
      "schema": "TeacherStudentLink",
      "description": "Vínculos formais autorizados entre professor e estudante"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Cursos acadêmicos oficiais"
    },
    "/lessons/{lessonId}": {
      "schema": "Lesson",
      "description": "Aulas estruturadas dos cursos"
    },
    "/student_progress/{progressId}": {
      "schema": "UserProgress",
      "description": "Progresso de estudos e domínio técnico"
    },
    "/practice_records/{recordId}": {
      "schema": "PracticeRecord",
      "description": "Registros de rotina prática e metrônomo"
    },
    "/system_roles/{userId}": {
      "schema": "UserRoleRecord",
      "description": "Registro autoritativo de papéis do sistema"
    },
    "/admin_logs/{logId}": {
      "schema": "AdminLogEntry",
      "description": "Registros imutáveis de auditoria de segurança e eventos de autenticação"
    }
  }
}
